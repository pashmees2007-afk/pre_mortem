# Server-only URL used by app/api/backend/[...path]/route.ts.
# Do not use a NEXT_PUBLIC_ variable for this address or for access tokens.
PREMORTEM_API_URL=https://api.example.com

# The cookie name is intentionally not configurable from the browser.
# A trusted authentication callback must set this HTTP-only cookie after sign-in.
PREMORTEM_ACCESS_COOKIE=pm_access_token
