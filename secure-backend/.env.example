NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/premortem
REDIS_URL=redis://localhost:6379

# Provider credentials are server-only. Never expose this value to a browser.
GROQ_API_KEY=replace-with-your-server-side-groq-key
GROQ_RETRIEVAL_MODEL=groq/compound-mini

# Qwen handles typed reasoning through Groq. Compound Mini stays web-evidence-only.
GROQ_STRUCTURED_MODEL=qwen/qwen3.8-27b

# JWTs must be issued by your identity provider with: sub, org_id, role.
JWT_SECRET=replace-with-a-minimum-32-character-secret
JWT_ISSUER=premortem-api
JWT_AUDIENCE=premortem-web

ANALYSIS_TIMEOUT_MS=25000
MAX_PLAN_CHARS=12000
ANALYSIS_RATE_LIMIT=3
ANALYSIS_RATE_WINDOW_SECONDS=600

# Password-reset email delivery is optional. Without RESEND_API_KEY, reset links are logged
# server-side only (dev mode) and never sent or returned to the client.
# RESEND_API_KEY=replace-with-your-resend-api-key
# MAIL_FROM=PreMortem <no-reply@yourdomain.com>
# APP_BASE_URL=https://your-dashboard-domain.example.com
